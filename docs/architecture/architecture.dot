    "git_branch_manager::view::list_state::nav" -> "git_branch_manager::types" [color="#7f7f7f", style=dashed, constraint=true];
    "git_branch_manager::view::list_state::nav" -> "git_branch_manager::view" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::list_state::nav" -> "git_branch_manager::view::list_state" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::list_state::sort" -> "git_branch_manager::view" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::list_state::sort" -> "git_branch_manager::view::column" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::list_state::sort" -> "git_branch_manager::view::list_state" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::remotes" -> "git_branch_manager::view::column" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::remotes" -> "git_branch_manager::view::filter" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::sort_keys" -> "git_branch_manager::config" [color="#7f7f7f", style=dashed, constraint=true];
    "git_branch_manager::view::sort_keys" -> "git_branch_manager::view" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::sort_keys" -> "git_branch_manager::view::column" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::tags" -> "git_branch_manager::view::column" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::tags" -> "git_branch_manager::view::filter" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::worktrees" -> "git_branch_manager::view::column" [color="#7f7f7f", style=dashed, constraint=false];
    "git_branch_manager::view::worktrees" -> "git_branch_manager::view::filter" [color="#7f7f7f", style=dashed, constraint=false];

    // binary-shell edges (app/main -> library), from source
    "main" -> "app" [color="#444444", penwidth=1.3];
    "main" -> "git_branch_manager::cli" [color="#444444", penwidth=1.3];
    "app" -> "git_branch_manager::ui" [color="#444444", penwidth=1.3];
    "app" -> "git_branch_manager::view" [color="#444444", penwidth=1.3];
    "app" -> "git_branch_manager::git" [color="#444444", penwidth=1.3];
    "app" -> "git_branch_manager::config" [color="#444444", penwidth=1.3];
    "app" -> "git_branch_manager::types" [color="#444444", penwidth=1.3];

    // invisible ordering anchors
    "main" -> "app" [style=invis, weight=20, constraint=true];
    "app" -> "git_branch_manager::ui" [style=invis, weight=20, constraint=true];
    "git_branch_manager::ui" -> "git_branch_manager::view" [style=invis, weight=20, constraint=true];
    "git_branch_manager::view" -> "git_branch_manager::git" [style=invis, weight=20, constraint=true];
    "git_branch_manager::git" -> "git_branch_manager::config" [style=invis, weight=20, constraint=true];
    "git_branch_manager::config" -> "git_branch_manager::types" [style=invis, weight=20, constraint=true];
}
